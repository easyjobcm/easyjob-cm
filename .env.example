# ============================================================
# EasyJob CM - Environment Template
# Copy this file to .env.local and fill with real values.
# Never commit .env.local or production secrets.
# ============================================================

# --- Supabase (required for app runtime) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Required by seed scripts / server admin ops (never expose in client)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- App base URL ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- OAuth Google (lu par la CLI Supabase locale via supabase/config.toml) ---
# À renseigner dans .env (à la racine) pour `supabase start`.
# Côté Next.js, mettre NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false pour masquer le bouton si non configuré.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# --- Twilio SMS (prod uniquement, requis pour [auth.sms.twilio]) ---
# Account SID + Auth Token : https://console.twilio.com/
# Message Service SID : créer un Messaging Service avec un sender ID "EasyJob"
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=


# --- EasyBot (/api/chat) — docs/chatbot.md ---
# Clé de la passerelle Vercel AI (facultative sur Vercel : jeton OIDC du projet).
# Sans clé hors Vercel, /api/chat répond 503 sans aucun appel.
AI_GATEWAY_API_KEY=
# Facultatif, tests locaux uniquement : URL d'une passerelle simulée.
# Ne jamais définir en production.
EASYBOT_GATEWAY_URL=


# --- E-mails du recrutement de remplacement (lot 17d-4b, ANN-21) ---
# Serveur uniquement (aucun préfixe NEXT_PUBLIC_). Procédure d'activation :
# docs/deployment/production.md, « E-mails de remplacement ».
# disabled (défaut) | fake (simulé, sans réseau) | resend (envoi réel).
EMAIL_TRANSPORT=disabled
# Expéditeur sur le domaine easyjobcm.com. Retenu : EasyJob CM <noreply@easyjobcm.com>
# (même expéditeur que le SMTP Resend de Supabase Auth, réglage non modifié).
EMAIL_FROM=
# Adresse de réponse : obligatoire pour l'envoi réel. Laisser vide tant que la
# boîte prévue n'est pas créée et testée ; jamais une adresse noreply.
EMAIL_REPLY_TO=
# Clé dédiée à EasyJob (droit sending_access, domaine easyjobcm.com) ; jamais
# la clé utilisée comme mot de passe par le SMTP de Supabase Auth.
RESEND_API_KEY=
# Secret de signature des événements (whsec_…), page du webhook chez Resend.
RESEND_WEBHOOK_SECRET=
# Secret de la route interne d'envoi (32 caractères au moins).
EMAIL_DISPATCH_SECRET=
# Essai limité : adresses autorisées, séparées par des virgules. Hors
# production, l'envoi réel est refusé sans cette liste ; en preview, toujours.
EMAIL_RECIPIENT_ALLOWLIST=
# « true » seulement après un essai réel vérifié : l'écran annonce alors
# l'envoi comme en service.
EMAIL_DELIVERY_VERIFIED=
